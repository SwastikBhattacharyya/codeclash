{
  "name": "web",
  "version": "0.4.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:web": "node dist/web/server/server.mjs",
    "format": "biome format --write && prettier --write \"src/**/*.html\"",
    "lint": "biome lint",
    "check": "biome check --write && prettier --write \"src/**/*.html\""
  },
  "private": true,
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=26",
    "npm": ">=12"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/archivo": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "@lucide/angular": "^1.72.0",
    "@mdit/plugin-katex": "^1.2.0",
    "express": "^5.1.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.6",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
